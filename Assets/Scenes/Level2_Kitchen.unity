    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u3010\u5317\u4EAC\u70E4\u9E2D\u5B8C\u6574\u98DF\u8C31\u3011\r\n\u6B65\u9AA41\uFF1A\u6E05\u6D17\u814C\u5236\uFF0C\u70ED\u6C34\u70EB\u76AE\u6536\u7D27\u9E2D\u8868\u76AE\r\n\u6B65\u9AA42\uFF1A\u7ED9\u9E2D\u5B50\u76AE\u4E0B\u5439\u6C14\uFF0C\u76AE\u8089\u5206\u79BB\u5F00\r\n\u6B65\u9AA43\uFF1A\u5C06\u82F9\u679C/\u6D0B\u8471/\u6A59\u5B50/\u8471\u6BB5\u653E\u5728\u83DC\u677F\u5207\u5757\r\n\u6B65\u9AA44\uFF1A\u8C03\u914D\u8106\u76AE\u6C34\r\n\u25AA\u8702\u871C:\u767D\u7CD6
    = 2 : 1\r\n\u25AA\u9EA6\u82BD\u7CD6:\u5927\u7EA2\u6D59\u918B = 1 : 1\r\n\u6B65\u9AA45\uFF1A\u9E2D\u5B50\u5237\u7B2C\u4E00\u5C42\u8106\u76AE\u6C34
    \u2192 \u7B2C\u4E00\u6B21\u98CE\u5E72\r\n\u6B65\u9AA46\uFF1A\u8865\u5237\u8106\u76AE\u6C34
    \u2192 \u7B2C\u4E8C\u6B21\u98CE\u5E72\r\n\U0001F4A1\u79D8\u8BC0\uFF1A\u8868\u76AE\u5145\u5206\u5E72\u71E5\u662F\u8106\u76AE\u5173\u952E\uFF01\r\n\u6B65\u9AA47\uFF1A\u5206\u6BB5\u70D8\u70E4\r\n\u2460\u70E4\u7BB1\u9884\u70ED200\u2103\uFF0C\u653E\u5165\u9E2D\u5B50\u5148\u70E440\u5206\u949F\r\n\u2461\u53D6\u51FA\uFF0C\u9E2D\u76AE\u8865\u5237\u4E00\u5C42\u8702\u871C\u6C34\r\n\u2462\u8C03\u81F3180\u2103\uFF0C\u7EE7\u7EED\u70E420\u201130\u5206\u949F\r\n\u26A0\uFE0F\u65F6\u95F4\u592A\u77ED\u6CA1\u719F\u900F\u3001\u8D85\u65F6\u76F4\u63A5\u70E4\u7126\u70AD\u9ED1\uFF01\r\n\u6B65\u9AA48\uFF1A\u51FA\u7089\u9759\u7F6E15\u5206\u949F\uFF0C\u9501\u4F4F\u9E2D\u8089\u6C41\u6C34"
